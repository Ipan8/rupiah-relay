# Copy to .env (mode 600). NEVER commit the real file.
CELO_RPC_URL=https://forno.celo.org
RELAY_ADDRESS=
AGENT_PRIVATE_KEY=
ATTRIBUTION_TAG=celo_e8a3571fc9bd
# Loops-issued ERC-8021 tag (enrolment 21 Nov 2026, akun GitHub Ipan8).
# If ATTRIBUTION_TAG is empty, the agent derives it from the repo slug
# (codeFromRepo — same derivation the Celo Builders platform uses) as fallback.
REPO_SLUG=Ipan8/rupiah-relay
# Optional: Textile API key (quotes work with just a wallet; anonymous).
# A tx_test_ key only works on testnets (97, 84532) — NOT Celo mainnet.
TEXTILE_API_KEY=
TEXTILE_API_BASE=https://api.textilecredit.com/v2
# Agent loop tuning
POLL_INTERVAL_MS=60000
SLIPPAGE_BPS=50
# ERC-8004 registration (register-8004.js only — run after funding)
AGENT_URI=
